# Server
PORT=5000

# Frontend origin allowed by CORS.
# Development:  http://localhost:5174
# Production:   https://your-app.vercel.app   ← replace with your Vercel URL
CLIENT_URL=http://localhost:5174

# MongoDB connection string (required — never commit the real value)
# Local:  mongodb://127.0.0.1:27017/task-manager
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/task-manager
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager
